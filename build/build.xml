<?xml version="1.0" encoding="UTF-8"?>
<project name="OpenFIPS201 PIV Applet" default="all" basedir="..">

	<taskdef name="javacard" classname="pro.javacard.ant.JavaCard" classpath="tools/ant-javacard/ant-javacard.jar"/>
	<property name="version" value="2.0"/>
	<property name="outputPath" value="output"/>
	<property name="name" value="OpenFIPS201"/>

	<!-- Construct output paths -->
	<mkdir dir="${outputPath}/bin-release" />
	<mkdir dir="${outputPath}/bin-debug" />

	<target name="jc305-release">
		<property name="platform" value="jc305"/>
		<javacard jckit="tools/sdk/jcdk-3.0.5">
			<cap targetsdk="tools/sdk/jcdk-3.0.5" sources="src;src-platform/${platform}" debug="false" ints="true" aid="A00000030800001000" version="${version}" 
				 output="${outputPath}/bin-release/%n-v${version}-jc%j-%J.cap">
				<applet class="org.openfips201.applet.OpenFIPS201" aid="A000000308000010000100"/>
				<import jar="tools/sdk/org.globalplatform-1.6/gpapi-globalplatform.jar"/>
			</cap>
		</javacard>
	</target>


	<target name="jc305-debug">
		<property name="platform" value="jc305"/>
		<javacard jckit="tools/sdk/jcdk-3.0.5">
			<cap targetsdk="tools/sdk/jcdk-3.0.5" sources="src;src-platform/${platform}" debug="true" ints="true" aid="A00000030800001000" version="${version}" 
				 output="${outputPath}/bin-debug/%n-v${version}-jc%j-%J.cap">
				<applet class="org.openfips201.applet.OpenFIPS201" aid="A000000308000010000100"/>
				<import jar="tools/sdk/org.globalplatform-1.6/gpapi-globalplatform.jar"/>
			</cap>
		</javacard>
	</target>
	
	<target name="jc304-release">
		<property name="platform" value="jc304"/>
		<javacard jckit="tools/sdk/jcdk-3.0.4">
			<cap targetsdk="tools/sdk/jcdk-3.0.4" sources="src;src-platform/${platform}" debug="false" ints="true" aid="A00000030800001000" version="${version}" 
				 output="${outputPath}/bin-release/%n-v${version}-jc%j-%J.cap">
				<applet class="org.openfips201.applet.OpenFIPS201" aid="A000000308000010000100"/>
				<import jar="tools/sdk/org.globalplatform-1.6/gpapi-globalplatform.jar"/>
			</cap>
		</javacard>
	</target>


	<target name="jc304-debug">
		<property name="platform" value="jc304"/>
		<javacard jckit="tools/sdk/jcdk-3.0.4">
			<cap targetsdk="tools/sdk/jcdk-3.0.4" sources="src;src-platform/${platform}" debug="true" ints="true" aid="A00000030800001000" version="${version}" 
				 output="${outputPath}/bin-debug/%n-v${version}-jc%j-%J.cap">
				<applet class="org.openfips201.applet.OpenFIPS201" aid="A000000308000010000100"/>
				<import jar="tools/sdk/org.globalplatform-1.6/gpapi-globalplatform.jar"/>
			</cap>
		</javacard>
	</target>

	<target name="all" depends="jc304-release,jc305-release">
		<tstamp/>
	</target>
</project>